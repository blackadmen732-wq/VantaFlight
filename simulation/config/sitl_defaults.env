# Default environment for PX4 SITL development.
# Copy to .env in the project root and adjust as needed.

VANTAFLIGHT_PX4_SITL_URL=udpin://0.0.0.0:14540
VANTAFLIGHT_PX4_CONNECTION_TIMEOUT=15.0
VANTAFLIGHT_DEFAULT_ADAPTER=mock
VANTAFLIGHT_STREAM_HZ=10
VANTAFLIGHT_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
